# Azure AD / Entra app registration
SHAREPOINT_TENANT_ID=your-tenant-id
SHAREPOINT_CLIENT_ID=your-application-client-id
SHAREPOINT_CLIENT_SECRET=your-client-secret-value

# Comma-separated list of site group keys to configure.
SITES=group1,group2

# --- Group: group1 ---
SITE_GROUP1_NAME=Group 1 Name
SITE_GROUP1_KB_NAME=GROUP1-sharepoint
# Comma-separated SharePoint site URLs for this group
SITE_GROUP1_URLS=https://site.sharepoint.com/sites/group1-site1
# Optional: comma-separated server-relative page paths to crawl (omit to crawl all pages)
# SITE_GROUP1_PAGE_PATHS=/sites/group1-site1/SitePages/Home.aspx,/sites/group1-site1/SitePages/Ohjeet.aspx

# --- Group: group2 ---
SITE_GROUP2_NAME=Group 2 Name
SITE_GROUP2_KB_NAME=GROUP2-sharepoint
# Multiple URLs → comma-separated
SITE_GROUP2_URLS=https://site.sharepoint.com/sites/group2-site1,https://site.sharepoint.com/sites/group2-site2
# Optional: page paths can be set at group level (applies to all URLs) …
# SITE_GROUP2_PAGE_PATHS=/sites/group2-site1/SitePages/Home.aspx
# … or per URL using a 0-based index suffix (takes precedence over group-level)
# SITE_GROUP2_0_PAGE_PATHS=/sites/group2-site1/SitePages/Home.aspx
# SITE_GROUP2_1_PAGE_PATHS=/sites/group2-site2/SitePages/Home.aspx,/sites/group2-site2/SitePages/About.aspx

# ---------------------------------------------------------------------------
# Global options (optional)
# ---------------------------------------------------------------------------
# Base directory for crawl output
OUTPUT_DIR=output

# Comma-separated file extensions to crawl (default: .pdf,.docx,.pptx,.xlsx)
# FILE_EXTENSIONS=.pdf,.docx,.pptx,.xlsx
